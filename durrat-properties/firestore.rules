rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function employeePath() {
      return /databases/$(database)/documents/employees/$(request.auth.uid);
    }

    function activeStaff() {
      return signedIn()
        && exists(employeePath())
        && get(employeePath()).data.active == true;
    }

    function superAdmin() {
      return activeStaff()
        && get(employeePath()).data.role == 'super_admin';
    }

    match /employees/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /properties/{propertyId} {
      allow read: if resource.data.published == true || activeStaff();
      allow create: if activeStaff()
        && request.resource.data.created_by_staff_id == request.auth.uid;
      allow update: if activeStaff()
        && request.resource.data.created_by_staff_id == resource.data.created_by_staff_id;
      allow delete: if activeStaff()
        && (superAdmin() || resource.data.created_by_staff_id == request.auth.uid);
    }
  }
}
